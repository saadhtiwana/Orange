{
  "$defs": {
    "Certification": {
      "additionalProperties": false,
      "properties": {
        "expires": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires"
        },
        "issued": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issued"
        },
        "issuer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issuer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Certification",
      "type": "object"
    },
    "Compensation": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "description": "ISO 4217 code, e.g. 'EUR'.",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "period": {
          "$ref": "#/$defs/CompensationPeriod",
          "default": "year"
        }
      },
      "required": [
        "currency"
      ],
      "title": "Compensation",
      "type": "object"
    },
    "CompensationPeriod": {
      "enum": [
        "hour",
        "month",
        "year"
      ],
      "title": "CompensationPeriod",
      "type": "string"
    },
    "DegreeLevel": {
      "enum": [
        "none",
        "high_school",
        "associate",
        "bachelor",
        "master",
        "doctorate"
      ],
      "title": "DegreeLevel",
      "type": "string"
    },
    "Education": {
      "additionalProperties": false,
      "properties": {
        "degree_level": {
          "$ref": "#/$defs/DegreeLevel"
        },
        "end": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "gpa": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gpa"
        },
        "gpa_scale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Scale the GPA is reported on, e.g. '4.0', '5.0', '10.0', '100'. Copy what the CV states; do not convert between scales.",
          "title": "Gpa Scale"
        },
        "institution": {
          "title": "Institution",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        }
      },
      "required": [
        "institution",
        "degree_level"
      ],
      "title": "Education",
      "type": "object"
    },
    "LanguageProficiency": {
      "enum": [
        "basic",
        "conversational",
        "professional",
        "native"
      ],
      "title": "LanguageProficiency",
      "type": "string"
    },
    "LanguageSkill": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Language name, e.g. 'German'.",
          "title": "Name",
          "type": "string"
        },
        "proficiency": {
          "$ref": "#/$defs/LanguageProficiency"
        }
      },
      "required": [
        "name",
        "proficiency"
      ],
      "title": "LanguageSkill",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "Link",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "Logistics": {
      "additionalProperties": false,
      "properties": {
        "desired_compensation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Compensation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notice_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notice Period"
        },
        "open_to_remote": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Open To Remote"
        },
        "requires_sponsorship": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requires Sponsorship"
        },
        "work_authorization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Work Authorization"
        }
      },
      "title": "Logistics",
      "type": "object"
    },
    "ProfileSource": {
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "file_type": {
          "description": "Extension or MIME type, e.g. 'pdf'.",
          "title": "File Type",
          "type": "string"
        },
        "parsed_at": {
          "format": "date-time",
          "title": "Parsed At",
          "type": "string"
        },
        "text_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hash of the extracted text, so evidence can be verified against the exact document that produced it.",
          "title": "Text Sha256"
        }
      },
      "required": [
        "file_name",
        "file_type",
        "parsed_at"
      ],
      "title": "ProfileSource",
      "type": "object"
    },
    "Skill": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "last_used": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Used"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "years": {
          "anyOf": [
            {
              "maximum": 60,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Years"
        }
      },
      "required": [
        "name"
      ],
      "title": "Skill",
      "type": "object"
    },
    "WorkExperience": {
      "additionalProperties": false,
      "properties": {
        "company": {
          "title": "Company",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "highlights": {
          "items": {
            "type": "string"
          },
          "title": "Highlights",
          "type": "array"
        },
        "is_current": {
          "default": false,
          "title": "Is Current",
          "type": "boolean"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "title": "Skills",
          "type": "array"
        },
        "start": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "company",
        "title"
      ],
      "title": "WorkExperience",
      "type": "object"
    }
  },
  "$id": "https://orange.dev/contracts/candidate_profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A parsed CV. Output of the CV parser, input to the ranker.",
  "properties": {
    "certifications": {
      "items": {
        "$ref": "#/$defs/Certification"
      },
      "title": "Certifications",
      "type": "array"
    },
    "education": {
      "items": {
        "$ref": "#/$defs/Education"
      },
      "title": "Education",
      "type": "array"
    },
    "emails": {
      "items": {
        "type": "string"
      },
      "title": "Emails",
      "type": "array"
    },
    "full_name": {
      "title": "Full Name",
      "type": "string"
    },
    "headline": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Headline"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id"
    },
    "languages": {
      "items": {
        "$ref": "#/$defs/LanguageSkill"
      },
      "title": "Languages",
      "type": "array"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "title": "Links",
      "type": "array"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/Location"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "logistics": {
      "$ref": "#/$defs/Logistics"
    },
    "phones": {
      "items": {
        "type": "string"
      },
      "title": "Phones",
      "type": "array"
    },
    "raw_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Extracted CV text. Evidence quotes are verified against this.",
      "title": "Raw Text"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "skills": {
      "items": {
        "$ref": "#/$defs/Skill"
      },
      "title": "Skills",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/ProfileSource"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Summary"
    },
    "total_years_experience": {
      "anyOf": [
        {
          "maximum": 60,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Years Experience"
    },
    "work_experience": {
      "items": {
        "$ref": "#/$defs/WorkExperience"
      },
      "title": "Work Experience",
      "type": "array"
    }
  },
  "required": [
    "source",
    "full_name"
  ],
  "title": "CandidateProfile",
  "type": "object"
}
