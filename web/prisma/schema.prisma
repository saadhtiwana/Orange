// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A role produced by the Job Architect.
///
/// `document` holds the full contract-conforming JobDescription exactly as the
/// AI service returned it — that is the source of truth, and `requirements`
/// lives inside it. The scalar columns above it are denormalised copies kept
/// only so the pipeline can list and filter jobs without opening the JSON.
///
/// Job columns are owned by Job Intelligence. `Candidate`, `Profile`, and
/// `Score` live in this same schema file under Ingestion & Profiles; `scores`
/// is the back-relation the ranker uses to list scores for a job.
model Job {
  id             String   @id @default(uuid())
  title          String
  seniority      String
  employmentType String   @map("employment_type")
  workMode       String   @map("work_mode")
  locations      String[]
  summary        String

  document      Json
  schemaVersion String  @map("schema_version")
  model         String?
  promptVersion String? @map("prompt_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scores Score[]

  @@index([createdAt])
  @@map("jobs")
}

model Candidate {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  source    String
  createdAt DateTime  @default(now())
  profiles  Profile[]
  scores    Score[]
}

// Week 2: add a pgvector embedding column here — not implemented yet.
model Profile {
  id             String    @id @default(cuid())
  candidateId    String
  candidate      Candidate @relation(fields: [candidateId], references: [id])
  rawText        String?
  parsedJson     Json?
  confidenceJson Json?
  resumeUrl      String
  createdAt      DateTime  @default(now())

  @@index([candidateId])
}

model Score {
  id                  String    @id @default(cuid())
  candidateId         String
  candidate           Candidate @relation(fields: [candidateId], references: [id])
  jobId               String
  job                 Job       @relation(fields: [jobId], references: [id])
  overallScore        Float
  dimensionScoresJson Json
  reasoningText       String
  createdAt           DateTime  @default(now())

  @@index([candidateId])
  @@index([jobId])
}
