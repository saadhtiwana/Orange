# Copy to .env and fill in. Never commit .env.
# The web app reads web/.env; the AI service reads ai/.env. Symlinking or
# copying this file into both is the simplest local setup.

# ---------------------------------------------------------------------------
# Database (docker-compose.yml reads these from the repo-root .env)
# ---------------------------------------------------------------------------
POSTGRES_USER=orange
POSTGRES_PASSWORD=orange
POSTGRES_DB=orange
POSTGRES_PORT=5432

# Prisma is the only writer. Must match the values above.
DATABASE_URL=postgresql://orange:orange@localhost:5432/orange?schema=public

# ---------------------------------------------------------------------------
# AI service (ai/)
# ---------------------------------------------------------------------------
# POST /job/architect needs a key for whichever provider LLM_PROVIDER selects.
# Only that one is required; the rest can stay blank.
#
#   LLM_PROVIDER   key needed            get one at
#   -----------------------------------------------------------------------
#   grok | xai     XAI_API_KEY           https://console.x.ai/
#   gemini|google  GEMINI_API_KEY        https://aistudio.google.com/apikey
#   openrouter     OPENROUTER_API_KEY    https://openrouter.ai/keys
#   anthropic      ANTHROPIC_API_KEY     https://console.anthropic.com/
#
# xAI, Gemini and OpenRouter all speak the OpenAI wire format and share one
# client; Anthropic uses its own SDK. Switching provider is LLM_PROVIDER plus a
# matching LLM_MODEL — nothing else changes.
XAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

LLM_PROVIDER=grok
# Must match the provider above. Known-good ids:
#   grok        -> grok-4                       (xAI flagship)
#   gemini      -> gemini-2.5-pro               (or gemini-2.5-flash, cheaper)
#   openrouter  -> deepseek/deepseek-chat-v3.1:free   (vendor/model[:tag])
#   anthropic   -> claude-opus-5
LLM_MODEL=grok-4
# Caps thinking and response together — too low truncates the JD mid-object.
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
CORS_ORIGINS=["http://localhost:3000"]

# Base URLs are only overridden for a proxy or a self-hosted gateway.
# XAI_BASE_URL=https://api.x.ai/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# Web app (web/)
# ---------------------------------------------------------------------------
# Where the Next.js route handlers reach the FastAPI service. Server-side only:
# no NEXT_PUBLIC_ prefix, so it never reaches the browser bundle.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=120000
