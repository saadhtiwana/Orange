# Copy to .env and fill in. Never commit .env.
# The web app reads web/.env; the AI service reads ai/.env. Symlinking or
# copying this file into both is the simplest local setup.

# ---------------------------------------------------------------------------
# Database (docker-compose.yml reads these from the repo-root .env)
# ---------------------------------------------------------------------------
POSTGRES_USER=orange
POSTGRES_PASSWORD=orange
POSTGRES_DB=orange
POSTGRES_PORT=5432

# Prisma is the only writer. Must match the values above.
DATABASE_URL=postgresql://orange:orange@localhost:5432/orange?schema=public

# ---------------------------------------------------------------------------
# AI service (ai/)
# ---------------------------------------------------------------------------
# Required for POST /job/architect. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# Caps thinking and response together — too low truncates the JD mid-object.
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# Web app (web/)
# ---------------------------------------------------------------------------
# Where the Next.js route handlers reach the FastAPI service. Server-side only:
# no NEXT_PUBLIC_ prefix, so it never reaches the browser bundle.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=120000
